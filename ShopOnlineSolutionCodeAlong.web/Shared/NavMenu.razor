﻿<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><span class="fas fa-shopping-cart"></span>&nbsp;ShopOnline</a>
@*      Ive deviated from the tutoiral for CartMenu display in am attempt to have a better looking UI 
        and less code duplication. The below div only shows on mobile (at the sm bootrap breakpoint). 
        I always have two cartmenus (one here and one in mainlayout.razor), 
        when one is hidden the other is showing and vice versa. 
        I think this is inefficient and could do with some nice css to remove duplicate objects 
        (which unnecesarily consume resources) but thats outside the scope of this project. 
        Annoyingly, i think its just as inefficient as the original authors only with less code duplication
        across components and classes, which is a win imo. *@
        <div class="ms-auto d-block d-sm-none">
            <CartMenu />
        </div>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <!-- Match="NavLinkMatch.All" highlights the link in the menu only if the URL exactly matches the href. -->
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="fas fa-home" aria-hidden="true"></span>&nbsp;Home
            </NavLink>
        </div>
    <ProductCategoriesNavMenu />
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}