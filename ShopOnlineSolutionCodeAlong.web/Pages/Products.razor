@* This page directive specifies the path at which this razor component is invokes, in this case its the website root path '/' *@
@page "/"

@* This using direcctive can be referenced here or globally for views in the _Imports.razor file*@
@using ShopOnlineCodeAlong.Modells.Dtos

@inherits ProductBase

@code {
    //We could call our service here but in the interest of keeping the code clean the code has been abstracted into a base class, ProductBase.cs
    //This razor component will then inherit from that base class
}

@if(Products == null)
{
    <DisplaySpinner/>
}
else
{
    <h3 class="mb-5">Products</h3>
    var productsCount = Products.Count();

    if(productsCount > 0)
    {
        foreach(var group in GetGroupedProductsByCategory())
        {
            <h3>@GetCategoryName(group)</h3>
            <div class="row mt-3">
                <DisplayProducts Products="@group"></DisplayProducts>
            </div>
            <hr/> 
        }
    }
    


}
