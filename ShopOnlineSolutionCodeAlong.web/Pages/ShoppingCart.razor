@page "/ShoppingCart"
@inherits ShoppingCartBase

@if(ErrorMessage == null && ShoppingCartItems == null)
{
	<DisplaySpinner></DisplaySpinner>
}
else if (ErrorMessage != null)
{
	<DisplayError ErrorMessage="@ErrorMessage"></DisplayError>
}
else
{
	if(ShoppingCartItems.Count > 0)
	{
		<h3 class="mb-5">Shopping Cart</h3>
		<div class="row mb-5">
			<div class="col-md-9">
				@foreach (var item in ShoppingCartItems)
				{
					<div class="row-mb-4">
						<div class="col-md-4">
							<img src="@item.ProductImageURL" width="300" class="img-thumbnail" />
						</div>
						<div class="mb-4">@item.ProductDescription</div>
						<span>Price: <b>@item.Price</b></span>
						<div>
							<button @onclick="(() => DeleteCartItem_Click(item.Id))"
							class="btn btn-danger sm">
								<i class="fa fa-trash"></i>
							</button>
						</div>
					</div>
				}
			</div>

			<div class="col-md-3">
				<h5>Cart Summary</h5>
				<div class="mt-2">
					<div>
						Total -
					</div>
					<a href="#" class="btn btn-success">
						<span class="oi oi-credit-card">&nbsp; Proceed to Checkout</span>
					</a>
				</div>
			</div>
		</div>
	}
	else
	{
		<h4>There are no items in the shopping cart</h4>
	}
}